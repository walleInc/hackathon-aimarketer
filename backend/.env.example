# --- База данных ---
# Локально: SQLite. Для продакшна: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data.db

# --- Telegram ---
BOT_TOKEN=
# Публичный HTTPS-адрес (Mini App и webhook). Пусто = бот работает через long polling.
PUBLIC_URL=
WEBHOOK_SECRET=change-me-long-random
# Telegram ID администраторов через запятую
ADMIN_IDS=

# --- Безопасность ---
# Fernet-ключ для шифрования токенов соцсетей:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# ТОЛЬКО для локальной разработки: вход по заголовку X-Dev-User без initData
DEV_AUTH_BYPASS=false

# --- LLM ---
# stub | openai | chatgpt_account
LLM_PROVIDER=stub
OPENAI_API_KEY=
# Для другого ИИ с OpenAI-совместимым API укажите адрес и модель, например:
#   OpenRouter: https://openrouter.ai/api/v1   DeepSeek: https://api.deepseek.com/v1
#   Ollama (локально): http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Прочее ---
MEDIA_DIR=media
SCHEDULER_INTERVAL_SEC=30
